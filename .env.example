# ============================================================
# Faceless channel pipeline - step 1 configuration
# Copy this file to `.env` and fill in your real values:
#     cp .env.example .env
# NEVER commit your real .env to git (it is already in .gitignore).
# ============================================================

# REQUIRED for script generation.
# Get a free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ---- Optional overrides (defaults shown; uncomment to change) ----

# Model selection. By default the script tries a built-in fallback chain
# (gemini-3.1-pro-preview -> gemini-flash-latest -> flash-lite -> legacy 2.5)
# and uses the first model that responds.
# Force ONE specific model:
# GEMINI_MODEL=gemini-flash-latest
# Or provide your own chain (comma-separated, tried in order):
# GEMINI_MODELS=gemini-3.1-pro-preview,gemini-flash-latest
# NOTE: pro models are not included in the free tier (needs billing enabled
# in Google AI Studio). Flash models work on the free tier in most regions.

# Deep, authoritative male voice (Microsoft Edge neural voices).
# EDGE_TTS_VOICE=en-US-AndrewMultilingualNeural

# Speaking rate. "+10%" = 10% faster, "-5%" = 5% slower.
# Default is "+10%" - keeps the read near 40 s for a Shorts-length script.
# EDGE_TTS_RATE=+10%

# Pitch shift. "-3Hz" (default) sounds slightly deeper / less robotic.
# EDGE_TTS_PITCH=-3Hz

# ============================================================
# Step 1.5 - v2 "beats" script + voiceover style (OPTIONAL)
# ============================================================

# Script style: "beats" (v2 - Gemini returns structured beats with emotion,
# emphasis_words, visual_concept + a hook-strength gate) or "classic"
# (legacy plain script). Default: beats.
# SCRIPT_MODE=beats

# Voice backend: edge (free, default) | elevenlabs | playht.
# Premium backends need keys and fall back to edge on any failure.
# TTS_BACKEND=edge
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# PLAYHT_API_KEY=
# PLAYHT_USER_ID=
# PLAYHT_VOICE_URI=

# Hook gate: fail (and retry) script generation when beats[0] is not a
# provocative 8-12-word claim/question. HOOK_MIN_SCORE = soft 0-10 threshold.
# HOOK_GATE=on
# HOOK_MIN_SCORE=5

# ============================================================
# Step 2 - v2 assembly flags (all default to on; set "off" to disable)
# ============================================================

# Curated abstract footage library (curated_library/) matched per beat.
# CURATED_LIB=on

# Short zoom "pulse" (+5% easing back ~0.9s) at every beat cut.
# BEAT_PULSE=on

# Sidechain ducking: music dips to 45% while the voice speaks (v2 only).
# MUSIC_DUCKING=on

# Sound design: a soft whoosh into every scene cut + a distinct ding under
# emphasized words (synthesized, rights-cleared, ~-16..-20 dBFS so the
# voiceover always dominates).
# SFX=auto              # "off" disables the whole SFX layer
# SFX_LEVEL=1.0         # master gain over the built-in conservative levels

# Bold hook text pinned over the opening clip for the first ~2.6s.
# HOOK_OVERLAY=on
# HOOK_COLOR=#F5D90A

# ---- Hook style + caption safe zones (v2.1) -------------------------------

# How beat[0] (the hook) is presented:
#   title_card   - bold static hook text ALONE for ~1.4s, then the word-by-word
#                  captions take over (no duplicate text; default)
#   word_by_word - no overlay; beat[0] captions render ~15% bigger with a
#                  110%->100% scale-in over the first 150ms
#   both         - legacy: static overlay AND captions at the same time
# HOOK_STYLE=title_card

# Vertical caption anchor as a fraction of frame height (0=top, 1=bottom).
# 0.65 sits in the lower-middle third, clear of Instagram/TikTok top-UI and
# bottom description area. Horizontal bounds are fixed at 8% left / 18% right
# margin (the right margin clears the like/comment/share button rail).
# CAPTION_Y_PCT=0.65

# Debug: draw translucent red (platform-UI) / green (safe band) guide
# rectangles on a test render to visually confirm captions clear the UI.
# RENDER_SAFE_ZONE_GUIDES=off

# ============================================================
# Step 2 - dynamic Pexels scenes + ambient music (OPTIONAL)
# ============================================================

# Free API key from https://www.pexels.com/api/ - enables DYNAMIC
# backgrounds: one vertical Pexels clip per Gemini "search_query",
# hard-cut between scenes at the concept transitions. Without it the
# pipeline still works - it falls back to the static gradient background.
# PEXELS_API_KEY=...

# Music bed mixing volume (0-1). Default 0.1 = 10%, so the dark ambient
# bed stays under the voiceover (volumex-style ducking).
# MUSIC_LEVEL=0.1

# Set to "off" to disable the ambient music bed entirely.
# BG_MUSIC=auto

# Advanced: force an attempt at Gemini-generated music (no music model
# exists on the public Gemini API yet; the built-in procedural dark-ambient
# synth is used whenever Gemini returns no audio).
# GEMINI_MUSIC_MODEL=

# Background punch-in zooms (per-scene scale variance + a tighter push on
# the reframe turn). Set to "off" for a flat, untouched background scale.
# PUNCHINS=auto

# ============================================================
# Step 3 - auto-publish (OPTIONAL; on GitHub Actions use
#          repository Secrets instead of this file)
# ============================================================

# ---- YouTube (see tools/yt_refresh_token.py for the one-time setup) ----
# YT_CLIENT_ID=xxxxx.apps.googleusercontent.com
# YT_CLIENT_SECRET=xxxxx
# YT_REFRESH_TOKEN=xxxxx
# YouTube privacy for uploads: public (default) | unlisted | private
# YT_PRIVACY=public

# ---- Instagram ----
# Recommended unattended login: your browser session cookie (ig_did session).
# Browser -> instagram.com -> DevTools -> Application -> Cookies -> sessionid
# IG_SESSIONID=xxxxx
# ...or username/password (more likely to hit Instagram verification checks):
# IG_USERNAME=your_username
# IG_PASSWORD=your_password

# ============================================================
# Step 2.6 - automatic thumbnails
# ============================================================

# Which generated variant is auto-attached at upload time. All variants are
# always saved to output/<run_id>/thumbnails/ for review either way:
#   hook     = mid-hook frame + hook text (same beats[0] text, auto-shortened
#              to 3-6 punchy words with a quick Gemini call when it is long)
#   midpoint = strongest mid-video emotional beat frame + short text
#   clean    = highest-contrast frame of the whole video, no text
# THUMBNAIL_VARIANT=hook

# Set to false while testing: variants are still generated + saved for
# review, but the upload step attaches nothing. Remove/re-set to true to
# go back to automatic.
# AUTO_UPLOAD_THUMBNAIL=true

# Tuning (rarely needed):
# THUMB_FLAT_STD=14        # frame "flatness" threshold (brightness std-dev)
# THUMB_GRADIENT_STD=30    # below this contrast the dark gradient kicks in
# GEMINI_THUMB_MODEL=gemini-2.5-flash-lite   # hook-text shortening model
